{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "declaration": false
  },
  "include": [
    "src/**/*.ts",
    "prisma7.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "generated"
  ]
}